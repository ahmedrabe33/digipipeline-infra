# ==================================================
# DigiPipeline Reusable Project Configuration
# Copy this file to .env and edit it for your project
# ==================================================

# AWS
AWS_PROFILE=default
AWS_REGION=us-east-1
JENKINS_AWS_REGION=us-west-2

# SSH key used for Bastion and Jenkins
DIGIPIPELINE_KEY_NAME=devops-ha-eks-bastion-key
DIGIPIPELINE_KEY_PATH=$HOME/.ssh/devops-ha-eks-bastion-key.pem

# Project identity
DIGIPIPELINE_PROJECT_NAME=my-project
DIGIPIPELINE_ENVIRONMENT_NAME=development

# Application settings
DIGIPIPELINE_APP_NAME=myapp
DIGIPIPELINE_APP_NAMESPACE=myapp-dev
DIGIPIPELINE_APP_INGRESS_NAME=myapp-ingress
DIGIPIPELINE_APP_SECRET_NAME=app-secrets

# Repositories
DIGIPIPELINE_APP_REPO_URL=https://github.com/YOUR_USERNAME/YOUR_APP_REPO.git
DIGIPIPELINE_GITOPS_REPO_URL=https://github.com/YOUR_USERNAME/YOUR_GITOPS_REPO.git
DIGIPIPELINE_GITOPS_BRANCH=main
DIGIPIPELINE_GITOPS_APP_PATH=k8s/overlays/development

# Argo CD
DIGIPIPELINE_ARGOCD_APP_NAME=my-project-development
DIGIPIPELINE_ARGOCD_PROJECT=default

# Jenkins
DIGIPIPELINE_JENKINS_JOB_NAME=my-project
DIGIPIPELINE_GITHUB_CREDENTIALS_ID=github-pat-creds

# ECR
DIGIPIPELINE_ECR_REPOSITORY_NAME=myapp

# SonarQube
DIGIPIPELINE_SONAR_PROJECT_KEY=myapp
DIGIPIPELINE_SONAR_PROJECT_NAME="My App Platform"

# Database schema automation
# true only if your app uses the provided PostgreSQL schema logic
DIGIPIPELINE_ENABLE_DB_SCHEMA_AUTOMATION=false

# PostgreSQL values used by application secrets
DIGIPIPELINE_POSTGRES_DB=myapp
DIGIPIPELINE_POSTGRES_USER=myapp
DIGIPIPELINE_POSTGRES_PASSWORD=CHANGE_ME
