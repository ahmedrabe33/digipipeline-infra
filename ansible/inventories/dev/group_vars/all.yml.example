# ==================================================
# Reusable Project Settings
# Change this section when using another application
# ==================================================

project_name: "my-project"
environment_name: "development"

# Application identity
app_name: "myapp"
app_namespace: "myapp-dev"
app_ingress_name: "myapp-ingress"
app_secret_name: "app-secrets"

# Repositories
app_repo_url: "https://github.com/YOUR_USERNAME/YOUR_APP_REPO.git"
gitops_repo_url: "https://github.com/YOUR_USERNAME/YOUR_GITOPS_REPO.git"
gitops_branch: "main"
gitops_app_path: "k8s/overlays/development"

# Argo CD
argocd_namespace: "argocd"
argocd_project: "default"
argocd_app_name: "my-project-development"

# Jenkins
jenkins_job_name: "my-project"
github_credentials_id: "github-pat-creds"

# SonarQube
sonar_project_key: "myapp"
sonar_project_name: "My App Platform"
sonar_jenkins_credential_id: "sonarqube-token"

# Optional DB schema automation
# Set to false if your application has a different DB schema
enable_db_schema_automation: false
postgres_pod: "postgres-0"
postgres_db: "myapp"
postgres_user: "myapp"
postgres_password: "CHANGE_ME"

# Application runtime secrets
jwt_secret: "CHANGE_ME"

redis_host: "redis"
redis_port: "6379"
redis_url: "redis://redis:6379"

rabbitmq_host: "rabbitmq"
rabbitmq_port: "5672"
rabbitmq_user: "guest"
rabbitmq_password: "guest"
rabbitmq_url: "amqp://guest:guest@rabbitmq:5672"


# ==================================================
# AWS / Terraform Generated Values
# These values are generated by 00-rebuild-infra.yml
# Do not manually edit unless needed
# ==================================================

aws_profile: "default"
aws_region: "us-east-1"
jenkins_aws_region: "us-west-2"
aws_account_id: "YOUR_AWS_ACCOUNT_ID"

cluster_name: "devops-ha-eks"
vpc_id: "GENERATED_BY_TERRAFORM"

bastion_public_ip: "GENERATED_BY_TERRAFORM"
bastion_private_ip: "GENERATED_BY_TERRAFORM"
bastion_key_path: "~/.ssh/devops-ha-eks-bastion-key.pem"

ecr_repository_name: "your-app-image-repo"
ecr_repository_url: "GENERATED_BY_TERRAFORM"

jenkins_url: "GENERATED_BY_TERRAFORM"
jenkins_controller_public_ip: "GENERATED_BY_TERRAFORM"
jenkins_controller_private_ip: "GENERATED_BY_TERRAFORM"
jenkins_agent_private_ips: []

aws_lbc_policy_name: "GENERATED_BY_AUTOMATION"
aws_lbc_role_name: "GENERATED_BY_AUTOMATION"
aws_lbc_namespace: "kube-system"
aws_lbc_service_account_name: "aws-load-balancer-controller"

karpenter_namespace: "kube-system"
karpenter_service_account_name: "karpenter"
karpenter_controller_role_arn: "GENERATED_BY_TERRAFORM"
karpenter_node_role_name: "GENERATED_BY_TERRAFORM"
karpenter_ec2nodeclass_name: "default"
karpenter_nodepool_name: "default"
