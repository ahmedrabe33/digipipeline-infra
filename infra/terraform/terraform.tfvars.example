aws_region = "us-east-1"

cluster_name = "devops-ha-eks"

key_name = "devops-ha-eks-bastion-key"

my_ip_cidr = "YOUR_PUBLIC_IP/32"

bastion_instance_type = "t3.micro"

system_node_instance_type = "t3.medium"

kubernetes_version = "1.35"

# CI/CD
environment = "dev"

ecr_repository_names = [
   "your-app-image-repo"
]

jenkins_controller_instance_type = "t3.medium"
jenkins_agent_instance_type      = "t3.medium"
jenkins_agent_count              = 2
